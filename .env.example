# =============================================================================
# Dailydle / Quizzdle — environment variables (sample, no secrets)
# Copy to .env.local and fill with real values. NEVER commit .env or .env.local.
# =============================================================================

# ----- Chain config -----
# 84532 = Base Sepolia, 8453 = Base mainnet
NEXT_PUBLIC_CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# ----- Deployer EOA -----
# Funds the deployment + admin transactions. Keep on a wallet that does NOT
# sign anything else and is rotated after every prod incident.
PRIVATE_KEY=

# ----- Server signer (separate EOA from deployer) -----
# This wallet signs guess attestations. If compromised, an attacker can fake
# wins for any address they control. Rotate immediately on suspicion.
SERVER_PRIVATE_KEY=

# ----- Game salt (server-only secret) -----
# 32-byte hex (0x + 64 hex chars). Used to salt daily-character derivation
# and the saltedGuess hashes. If it leaks, on-chain answers become decodable.
SALT_DECRYPT=

# ----- Admin API secret (for /api/flag-wallet) -----
# Long random string. MUST be different from SALT_DECRYPT — sharing the value
# means a leak of one is a leak of both.
ADMIN_SECRET=

# ----- Device cookie HMAC key (server-side multi-wallet detection) -----
# Long random string (32+ chars). Used to sign the qz-did HttpOnly cookie
# that identifies a player's device in /api/guess for multi-wallet flagging.
# Without it, the code falls back to SERVER_PRIVATE_KEY — works but mixes
# secret domains, so set a dedicated value in prod.
DEVICE_COOKIE_SECRET=

# ----- Quizzdle backend -----
QUIZZDLE_API_KEY=
NEXT_PUBLIC_QUIZZDLE_API_URL=https://quizzdle.com

# ----- Coinbase / OnchainKit -----
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# ----- Public app URL -----
NEXT_PUBLIC_URL=https://dailydle.vercel.app

# ----- Deployed contracts (fill after deploy) -----
NEXT_PUBLIC_GM_CONTRACT_ADDRESS=
NEXT_PUBLIC_REFERAL_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ----- Upstash Redis (REQUIRED in production) -----
# Stores pending guess reveals + rate-limit counters + device-wallet
# tracking. Without these, the API falls back to a per-instance in-memory
# Map — that breaks across serverless cold starts and lets an attacker
# multiply their inflight quota by the number of running instances.
# Create a free DB at https://console.upstash.com → copy REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Farcaster Mini App account association (public values) -----
HEADER=
PAYLOAD=
SIGNATURE=
